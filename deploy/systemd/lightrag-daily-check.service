[Unit]
Description=lightrag 每日斷言（compat-check + canary）
# exit 1 = 檢查紅燈，腳本已自行經 ntfy 通知，不算 unit 失敗；
# 其他非零 = 腳本本身掛掉。**2026-08-07 起沒有通知管道**（ntfy 已拆），
# 只會留在 journal：journalctl -u lightrag-daily-check

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/daily-check.sh
SuccessExitStatus=1
