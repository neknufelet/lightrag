# LightRAG 1.5.5 — 每個實例一份 .env，複製此檔後填入密鑰。
# 實際的 .env 已被 .gitignore 排除，不要提交。

# ---- 實例識別 ----
# WORKSPACE 同時是 Postgres 的隔離欄位與 Neo4j 的節點標籤，每個知識庫必須唯一
WORKSPACE=changeme
HOST=0.0.0.0
PORT=9621
LIGHTRAG_API_KEY=changeme

# ---- 儲存後端 ----
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage

POSTGRES_HOST=lightrag-postgres
POSTGRES_PORT=5432
POSTGRES_USER=deeptutor
POSTGRES_PASSWORD=changeme
POSTGRES_DATABASE=lightrag

NEO4J_URI=bolt://deeptutor-v4-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ---- 抽取用 LLM（本機 llama.cpp）----
LLM_BINDING=openai
LLM_BINDING_HOST=http://100.71.26.77:8080/v1
LLM_BINDING_API_KEY=changeme
LLM_MODEL=qwen3.6-35b-a3b

# ---- Embedding ----
# 2026-08-01 從 text-embedding-3-small 換成 3-large。原本保留 small 是為了與舊自製
# 管線的向量可比，但舊管線即將退役，那個約束消失。趁重建時一併換掉：向量表名帶了
# 模型與維度（lightrag_vdb_*_text_embedding_3_large_3072d），換模型會建新表、舊表
# 原封不動，所以隨時可回頭比對。
# 用原生 3072，不截斷。OpenAI 的 Matryoshka 特性容許截斷到 1536，但那是真的丟掉一半
# 維度；相較之下 halfvec 的 fp16 量化損失小得多（向量已正規化，數值範圍完全在 fp16 內）。
# 注意：截斷需要另外設 EMBEDDING_SEND_DIM=true —— EMBEDDING_DIM 本身只做維度檢查與
# workspace 隔離，不會要求 API 降維（OpenAI binding 的 send_dimensions 預設關閉，只有
# Jina／Gemini 強制開啟）。設了 DIM 卻沒設 SEND_DIM 會讓 API 仍回 3072，LightRAG 用
# 陣列長度除以 1536 算數量多一倍，索引寫入失敗：
#   Vector count mismatch: expected 10 vectors but got 20 vectors
# 代價：每次重建約 US$6（390 份）。LightRAG 沒有「只重算向量」的路徑，
# 換模型必須重新索引；不過 ENABLE_LLM_CACHE_FOR_EXTRACT 預設 true 且確實生效，
# chunk 文字不變的部分抽取會命中快取，所以重建成本主要是向量本身。
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=changeme
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# pgvector 的 HNSW 對 vector 型別上限 2000 維，3072 會建索引失敗 —— 而且是靜默的：
# 表建得起來、資料寫得進去、服務 healthy，只有啟動日誌留一行 ERROR，查詢從此退化成
# 全表掃描。halfvec 是半精度型別，HNSW 上限 4000 維。需要 pgvector >= 0.7.0（本機 0.8.2）。
POSTGRES_VECTOR_INDEX_TYPE=HNSW_HALFVEC



# ---- 解析與切塊 ----
LIGHTRAG_PARSER=pdf:mineru-P;*:legacy-R
MINERU_API_MODE=official
MINERU_API_TOKEN=changeme
MINERU_API_URL=https://mineru.net/api/v4

# 必須為 true。MinerU 的文字層路徑會靜默吃掉 x-height 字母（a c e g m n o r s u w y），
# 對文字層完好的非掃描 PDF 反而最嚴重 —— 2026-08-01 實測 C Equivalent Networks
# 有 27.6% 的 chunk、1,660 個掉字片段。is_ocr 走重讀像素的路徑可繞開，已驗證修復。
# model_version=vlm 無效。
MINERU_IS_OCR=true

# pipeline 而非預設的 vlm。2026-08-01 在 C Equivalent Networks 上實測（同檔、同 is_ocr）：
# vlm 有 16/57 個表格區域完全空白 —— table_body 缺席、img_path 也空，連圖片備份都沒有，
# 內容徹底遺失；pipeline 只有 9/57，表格內容量 189,430 vs 86,671 字元。真實掉字兩者
# 都約等於零（pipeline 的 8 個裡有 7 個是 LaTeX \mathrm{ i n t e r i o r } 的誤判）。
MINERU_MODEL_VERSION=pipeline

# MinerU 的語言參數。實測 vlm 與 pipeline 在英文語料上 ch/en 產出完全相同（556 區塊分毫不差），
# 所以這個值目前不影響結果，設 en 只是與語料一致。
MINERU_LANGUAGE=en

# 表格與公式辨識，兩者預設就是 true，列出來是為了不必再去翻原始碼確認。
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true

# ---- 抽取行為 ----
# 必須為 true。本機 4-bit 模型的關係記錄只吐 4/5 個欄位，不開的話會被 LightRAG
# 100% 拒收（實測 38 entities + 0 relations）。開啟後格式錯誤歸零。
ENTITY_EXTRACTION_USE_JSON=true

ENABLE_LLM_CACHE=false
RERANK_BINDING=null
# 本機 llama.cpp 沒開 --parallel 時只有 1 個 slot（實測 /slots 回 1），
# 請求會排隊。MAX_ASYNC=4 打 1 個 slot，第 4 個請求要等前 3 個跑完，
# 實際等待約 4 倍單次時間，直接撞上外層 480s（=LLM_TIMEOUT 240 的兩倍）
# —— 實測 10 次逾時、1 份文件整份失敗，而逾時的 chunk 大小都很正常。
# 兩張 GPU 幫不上忙：層分割仍是一個實例、一次一個 forward pass。
# 真正要提升吞吐得在伺服器端開 --parallel N（連續批次），開了之後
# MAX_ASYNC 才有意義往上調。
#
# ── 2026-08-03：上面那個條件已經成立，值改成 4（SPEEDUP-2）──────────
# 伺服器現在跑 --parallel 4（啟動 log n_slots = 4、n_ctx_slot = 32768），
# 所以 4 個並行請求各進一個 slot，不再排隊 —— 上面那場逾時災難的成因
# （4 個請求擠 1 個 slot）已經不存在。
#
# 實測（scripts/llm-bench.py，8 個真實抽取請求、cache_prompt=false、
# max_tokens=4096、無截斷、兩輪反序；報告在 $RECORDS/bench/）：
#
#   併發 1   67.8／68.0 tok/s   p50 25 s
#   併發 2   84.0／81.8         p50 32／40 s     ← 舊值
#   併發 4  107.5／105.4        p50 60／64 s     ← +28%，本值
#   併發 8  110.0／112.9        p50 97／110 s    ← 只再多 4.6%，延遲翻倍
#
# 不調到 8 的理由就是最後一列：GPU 在 4 已接近飽和（曲線壓平），
# 再加併發只換到延遲。c=4 最慢一題實測 95 s，對 LLM_TIMEOUT=600 有 6 倍餘裕。
LLM_TIMEOUT=600
MAX_ASYNC=4

# ── 後處理：第二雙眼睛（交叉驗證用）──────────────────────────────
# 必須跟 LLM_MODEL 不同家族，否則錯誤相關、交叉驗證失去意義。
# 金鑰預設沿用 EMBEDDING_BINDING_API_KEY，不另外散一份出去。
PP_EYE_B_HOST=https://api.openai.com/v1
PP_EYE_B_MODEL=gpt-5.6-luna
# gpt-5 系列是推理模型：要用 max_completion_tokens，且不接受 temperature=0
#（實測回 "Only the default (1) value is supported"），所以輸出是隨機的。
PP_EYE_B_REASONING=true
PP_EYE_B_MAX_OUT=6000

# ── 部署（依機器而異）──
# 服務綁定位址。腳本一律從這裡讀，不要寫死 localhost
BIND_ADDR=127.0.0.1
HOST_PORT=9621
# kbapi（唯讀圖片／單篇結構端點）發佈到宿主的埠。容器內恆為 9700。
# 為什麼要這個鍵：compose.yaml 進版控、被多個 checkout 共用，而「哪個 workspace
# 佔 9700」是**部署事實**不是原始碼事實。曾經用 `profiles:` 在檔案裡停用某一邊，
# 結果分支合併時那行跟著進主線，:9700 靜靜消失、skill 全啞且不報錯。
# 規則：現役的那個 workspace 用 9700（skill 寫死打它），其餘候補庫錯開（9701…）。
KBAPI_PORT=9700
# 收件匣／審核台對外的宿主埠；容器內固定使用 9710。
# 為什麼是 9710：避免與 LightRAG :9621、kbapi :9700 的既有端點重疊，且與
# 2026-08-04 實測的手動 intake 服務埠一致，compose 接手後不必改入口網址。
INTAKE_PORT=9710
# 收件匣要掃描的來源白名單，可用逗號分隔多個目錄。
# **刻意留空（2026-08-07）**：舊值是 /data/rag/knowledge_bases/Room_Optimizer/raw，
# 而 PO 已定案廢除 /data/rag，該目錄本身也已不存在。留空是安全的 ——
# intake.py:1778 會過濾掉空字串，且 :494 在沒有來源時明確警告「尚未設定
# INTAKE_SOURCES；選片清單不代表來源為空」，不會把「沒設定」講成「來源是空的」。
# 現在的進料方式是把 PDF 丟進 DATA_ROOT/inbox 或直接在 :9710 網頁上拖拉上傳。
# 要恢復掃描某個來源庫時，指向該庫的 PDF 目錄，並確認 compose 對它是唯讀掛載
# （避免 intake 寫回別人的語料）。
INTAKE_SOURCES=
# 所有 lightrag 資料的根目錄，放在 /data 的獨立 NVMe，與其他 RAG 專案完全切開。
# compose 會從這裡分出 inputs/<workspace>、work/parsed、work/crops、records、
# checks 與 rag_storage；DB 仍由 LIGHTRAG_DB_ROOT 另外控制。備份範圍與還原責任
# 以 dker 上的實際排程設定為準，不能只靠這行文字推定。
DATA_ROOT=/data/lightrag
# 可選的 inputs 宿主目錄。留空時由 compose 使用 DATA_ROOT/inputs，並讓 LightRAG
# 在其下建立 ${WORKSPACE} 子目錄；不要直接指向別的語料庫來源目錄。
INPUTS_DIR=

# ── Mathpix：方程式的第三隻眼睛 ──
# 為什麼要第三個：兩眼一致時判定可靠，但實測 30 條裡 11 條（37%）兩眼不一致，
# 那時候誰對誰錯沒有依據 —— qwen 會誤讀羅馬數字、luna 會看錯字元，兩個都可能錯。
# Mathpix 專為數學訓練，失誤型態與通用 VLM 不相關，正好打破僵局。
# 額度有限時只問「兩眼分歧最大」的，均勻亂抽等於浪費。
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ── 第三隻眼睛（OpenRouter）：只在三方皆異時才呼叫 ──
# 為什麼走 OpenRouter：一把金鑰通吃多個家族，換模型是改設定不是寫 adapter。
# 這跟「綁模型的觀察會過期」那條規則直接相關（compat-check A-23）——
# 換代成本趨近於零，才有可能真的定期換。
#
# 家族必須跟 LLM_MODEL（qwen）和 PP_EYE_B_MODEL（openai）都不同，
# eyes.assert_distinct() 會擋下重複 —— 同家族的系統性誤讀會一起發生，
# 多數決就變成一個血統投兩票。
#
# PP_EYE_C_PROVIDER 一定要填：OpenRouter 會把同一個模型 ID 路由到不同供應商，
# 輸出行為因此會變。交叉驗證的前提是「模型固定」，不釘住就分不清差異是
# 模型讀錯還是換了後端。供應商名稱在 openrouter.ai 的模型頁面查得到。
#
# 成本：只處理 13% 的三方皆異，390 份估算約 $0.7（Mathpix 同樣範圍要 $6.5）。
PP_EYE_C_HOST=https://openrouter.ai/api/v1
PP_EYE_C_MODEL=google/gemini-2.5-flash-lite
PP_EYE_C_API_KEY=
PP_EYE_C_PROVIDER=
# 很多模型（含 MiMo、gpt-5 系列、DeepSeek v4）是推理模型：推理會先吃掉額度，
# 不夠時 content 回空字串、finish_reason=length —— 看起來像模型壞掉，實際是
# 被截斷。本專案在三個不同模型上踩過同一個坑，所以額度一律給寬。
# 實測 MiMo 給 3072 時 4 條裡 2 條空回應，改 8000 全部正常。
PP_EYE_C_REASONING=false
PP_EYE_C_MAX_OUT=8000

# ---- 警報 ----
# 自架 ntfy（/opt/stacks/ntfy，手機訂閱 http://100.87.88.7:9800 的 lightrag 主題）。
# scripts/daily-check.sh 的失敗經 scripts/notify.sh 打到這裡。
# 為什麼是 ntfy 不是 email：這個專案的警報沒有可遠端決策的內容（紅燈＝來終端機查），
# 單向打斷人即可；email 要多接 SMTP relay 且更慢。狀態本身落地在 /data/lightrag/checks/。
NTFY_URL=http://127.0.0.1:9800/lightrag
