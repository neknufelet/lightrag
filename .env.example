# LightRAG 1.5.5 — 每個實例一份 .env，複製此檔後填入密鑰。
# 實際的 .env 已被 .gitignore 排除，不要提交。
#
# ══════════════════════════════════════════════════════════════════════════
# 秘密鍵清單：哪 7 個是秘密、重建時去哪裡拿
# ══════════════════════════════════════════════════════════════════════════
#
# **刻意不備份 .env 本身。** 備份秘密是負債（多一個地方會洩漏、會過期），
# 而且下表**每一個都不必備份**——不是重新產生就是去帳號重拿，右欄寫得清清楚楚。
# 真正需要記下來的只有「哪些是秘密、各自去哪裡拿」，也就是這一節。
#
# 現役的 .env 只在 florian-dker 的 `/opt/stacks/lightrag/.env`（chmod 600）。
# repo 路徑下的 `.env` 是指過去的 symlink，值只有一份（`ls -l` 看得到箭頭）。
# coder 上刻意沒有——那讓「我在 coder 上驗過了」在物理上做不到。
#
# 鍵數**刻意不寫死**（寫死的數字會過期，指令不會）。要數就跑：
#   grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' .env.example
#   ssh florian-dker "grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' /opt/stacks/lightrag/.env"
# ⚠ 用 `^[A-Z_]+=` 會漏掉含數字的鍵名（例如 `NEO4J_URI` 的 `4`）—— 2026-08-07
#   就是這樣少算 4 個並寫錯進 commit。
# ⚠ **不要 `source` 這份 .env。** `LIGHTRAG_PARSER` 的值含 `;`，shell 會把分號
#   後面當成一道指令（2026-08-08 實測 dker：`*:legacy-R: command not found`）。
#   要取單一鍵的值用 `grep -E '^KEY=' … | cut -d= -f2-`；只要鍵名用 `cut -d= -f1`。
#
#   鍵                          | 怎麼來的                  | 重建時
#   ----------------------------|--------------------------|---------------------
#   LIGHTRAG_API_KEY            | 自己產生的 32 字隨機串     | 重新產生
#   POSTGRES_PASSWORD           | 自己設的（**只有 8 字**）  | 重新產生，趁機加長
#   LLM_BINDING_API_KEY         | 本機 llama.cpp，48 字隨機  | 重新產生（伺服器端未必驗，`未驗`）
#   EMBEDDING_BINDING_API_KEY   | **本機 Infinity**，非 OpenAI | 重新產生（Infinity 端未必驗）
#   RERANK_BINDING_API_KEY      | 同上，Infinity 同一個容器   | 重新產生
#   MINERU_API_TOKEN            | MinerU 官網的 JWT          | 去 MinerU 官網拿
#   PP_EYE_B_API_KEY            | OpenAI（`sk-proj-…`）      | 去 OpenAI 帳號拿
#   PP_EYE_C_API_KEY            | OpenRouter（`sk-or-…`）    | 去 OpenRouter 帳號拿
#
# ⚠ **`EMBEDDING_BINDING_API_KEY` 自 2026-08-08 起不再是 OpenAI 金鑰**（embedding
#   切成本機 BGE-M3）。`pp/eyes.py:87` 的第二雙眼睛原本 fallback 沿用它去打
#   OpenAI，切換後那條路是斷的——2026-08-08 實測：同一把金鑰打
#   `api.openai.com/v1/models` 回 **401**、打 `:7997/models` 回 **200**。
#   **所以 `PP_EYE_B_API_KEY` 現在必須單獨設**，見下方後處理那節。
#
# ⚠ **MINERU_API_TOKEN 於 2026-09-04 到期**（`compat-check` 的 A-21 會在剩餘
#   14 天內讓 daily-check 紅燈）。重建若在那之後，這個一定要重拿。
#
# 產生隨機值：`openssl rand -base64 24 | tr -d /+= | cut -c1-32`
#
# ══════════════════════════════════════════════════════════════════════════

# ---- 實例識別 ----
# WORKSPACE 是 Postgres 的隔離欄位（四種儲存都在 PG，圖也是），每個知識庫必須唯一。
# 2026-08-07 之前它同時也是 Neo4j 的節點標籤，Neo4j 移除後只剩前者。
WORKSPACE=changeme
HOST=0.0.0.0
PORT=9621
LIGHTRAG_API_KEY=changeme

# repo checkout 的絕對路徑。kbapi 從那裡讀 scripts/（官方 python 映像 ＋ 掛程式碼，
# 不自建映像）。**沒有預設值**：compose 用 `${REPO_DIR:?…}`，沒設就整個指令失敗。
# 為什麼要它：compose.yaml 部署時會被複製到 /opt/stacks/lightrag/，那裡沒有
# scripts/，所以不能用 `./scripts` 這種相對路徑。
REPO_DIR=/home/florian/ghq/github.com/neknufelet/lightrag

# Dockge 的 stack 目錄，compose.yaml 與這份 .env 就住在那裡。
# systemd-units.py 用它填 lightrag-stack.service 的 @STACK_DIR@。
STACK_DIR=/opt/stacks/lightrag

# ---- 儲存後端 ----
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
# 圖後端 2026-08-07 從 Neo4JStorage 換成這個。v1.5.6 引進，圖存在普通表格＋JSONB，
# 不需要 Apache AGE。四種儲存於是全部在同一個 Postgres 上。
#
# 值不是猜的，是問映像本人：
#   docker run --rm --entrypoint sh ghcr.io/hkuds/lightrag:v1.5.6 -c \
#     'python -c "from lightrag.kg import STORAGE_IMPLEMENTATIONS as S; \
#                 print(S[\"GRAPH_STORAGE\"][\"implementations\"])"'
# v1.5.5 的同一份清單裡沒有它，所以升級是必要條件不是順便。
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage

POSTGRES_HOST=lightrag-postgres
POSTGRES_PORT=5432
POSTGRES_USER=deeptutor
POSTGRES_PASSWORD=changeme
POSTGRES_DATABASE=lightrag

# NEO4J_URI／NEO4J_USERNAME／NEO4J_PASSWORD／NEO4J_DATABASE 四個鍵已於
# 2026-08-07 隨 Neo4j 一起移除。**看到舊 .env 裡還有它們是正常的，直接刪。**
# （歷史備註：舊值曾寫成 bolt://deeptutor-v4-neo4j:7687，那會安靜地讀寫別的專案
# 的圖。這個坑隨鍵一起消失了。）

# ---- 抽取用 LLM（本機 llama.cpp）----
LLM_BINDING=openai
LLM_BINDING_HOST=http://100.71.26.77:8080/v1
LLM_BINDING_API_KEY=changeme
LLM_MODEL=qwen3.6-35b-a3b

# ---- Embedding ----
# 2026-08-08 從 OpenAI text-embedding-3-large@3072 換成**本機 BGE-M3@1024**，跑在
# dker 的 Infinity 容器（那台的 RTX 2070 原本完全閒置）。BINDING 仍是 `openai`——
# 那指的是 API 協定，不是供應商；Infinity 講的就是 OpenAI 相容協定。
#
# 為什麼敢換（都是並排實測，不是推論）：
#   * 五種 embedding 並排量過（3-large 的 3072／1536／1024、bge-m3、3-small），
#     維度差異落在雜訊範圍內，**1024 就夠**。
#   * 換 embedding 其實很便宜：切換只花 **45 秒**。關鍵是 chunk 沒動 ⇒ 抽取快取
#     452 筆全部命中，207 個 chunk 在 45 秒內走完，只有向量真的重算。
#     **貴的是動 chunk 大小與提示詞**（對照組改了 CHUNK_P_SIZE，快取全落空、抽兩小時）。
#   * 切換前後：chunk 207／207，節點 3,072→3,137，邊 4,289→4,423（走快取所以實體
#     相同，2% 差異來自合併順序）。切換前有 pg_dump 142 MB，**舊的 OpenAI 向量表
#     保留著當退路**——向量表名帶模型與維度，換模型會建新表、舊表原封不動。
#
# ⚠ 換模型或換維度就是換一張新的向量表，舊表不會被讀到，**在重新索引完成之前
#   所有查詢都會查不到**。這也是為什麼 rerank 可以隨時切、embedding 只能跟重進料
#   綁在一起做。
# ⚠ 這個坑留著給未來改回雲端 API 的人：截斷維度需要另外設 EMBEDDING_SEND_DIM=true
#   —— EMBEDDING_DIM 本身只做維度檢查與 workspace 隔離，不會要求 API 降維
#   （OpenAI binding 的 send_dimensions 預設關閉，只有 Jina／Gemini 強制開啟）。
#   設了 DIM 卻沒設 SEND_DIM，API 仍回原生維度，LightRAG 用陣列長度除以設定值
#   算出的數量多一倍，索引寫入失敗：
#     Vector count mismatch: expected 10 vectors but got 20 vectors
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://lightrag-infinity:7997
EMBEDDING_BINDING_API_KEY=changeme
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# pgvector 的 HNSW 對 vector 型別上限 2000 維，3072 會建索引失敗 —— 而且是靜默的：
# 表建得起來、資料寫得進去、服務 healthy，只有啟動日誌留一行 ERROR，查詢從此退化成
# 全表掃描。halfvec 是半精度型別，HNSW 上限 4000 維。需要 pgvector >= 0.7.0（本機 0.8.2）。
POSTGRES_VECTOR_INDEX_TYPE=HNSW_HALFVEC



# ---- 解析與切塊 ----
LIGHTRAG_PARSER=pdf:mineru-P;*:legacy-R
MINERU_API_MODE=official
MINERU_API_TOKEN=changeme
MINERU_API_URL=https://mineru.net/api/v4

# 必須為 true。MinerU 的文字層路徑會靜默吃掉 x-height 字母（a c e g m n o r s u w y），
# 對文字層完好的非掃描 PDF 反而最嚴重 —— 2026-08-01 實測 C Equivalent Networks
# 有 27.6% 的 chunk、1,660 個掉字片段。is_ocr 走重讀像素的路徑可繞開，已驗證修復。
# model_version=vlm 無效。
MINERU_IS_OCR=true

# pipeline 而非預設的 vlm。2026-08-01 在 C Equivalent Networks 上實測（同檔、同 is_ocr）：
# vlm 有 16/57 個表格區域完全空白 —— table_body 缺席、img_path 也空，連圖片備份都沒有，
# 內容徹底遺失；pipeline 只有 9/57，表格內容量 189,430 vs 86,671 字元。真實掉字兩者
# 都約等於零（pipeline 的 8 個裡有 7 個是 LaTeX \mathrm{ i n t e r i o r } 的誤判）。
MINERU_MODEL_VERSION=pipeline

# MinerU 的語言參數。實測 vlm 與 pipeline 在英文語料上 ch/en 產出完全相同（556 區塊分毫不差），
# 所以這個值目前不影響結果，設 en 只是與語料一致。
MINERU_LANGUAGE=en

# 表格與公式辨識，兩者預設就是 true，列出來是為了不必再去翻原始碼確認。
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true

# ---- 抽取行為 ----
# 必須為 true。本機 4-bit 模型的關係記錄只吐 4/5 個欄位，不開的話會被 LightRAG
# 100% 拒收（實測 38 entities + 0 relations）。開啟後格式錯誤歸零。
ENTITY_EXTRACTION_USE_JSON=true

# ── 自訂抽取規則（不 fork 映像的官方作法）────────────────────────────────
# LightRAG 從 `PROMPT_DIR/entity_type/<檔名>` 讀一份 YAML，覆寫實體型別的指引。
# 檔名**只能是檔名**（不得含目錄分隔符），目錄由 PROMPT_DIR 決定。
# 這兩個鍵由 lightrag/addon_params.py:49 讀進 addon_params。
#
# 內容與理由在 `prompts/entity_type/acoustics.yml`，摘要：
#   剔除參考文獻裡的人名與機構（體檢實測：跨文件共用實體有 36% 是這個）
#   不要把 `Figure 3`／`Equation 5`／`Table 2` 當實體（它們會**跨論文假合併**：
#   A 論文的第 5 式和 B 論文的第 5 式併成同一個節點，捏造出不存在的關聯）
#
# ⚠ 改這份 YAML 會讓**抽取快取全部落空**，下次進料要重抽（5 份約兩小時）。
#   換 embedding 反而很便宜（chunk 沒動 ⇒ 快取全命中，45 秒）——貴的是動提示詞。
PROMPT_DIR=/app/prompts
ENTITY_TYPE_PROMPT_FILE=acoustics.yml

# ── 兩個名字很像、管的是不同東西的快取 ──────────────────────────────
# ENABLE_LLM_CACHE（本鍵）管**查詢**：最終答案，以及查詢前那步「抽關鍵字」。
# ENABLE_LLM_CACHE_FOR_EXTRACT 管**進料時的實體抽取**，兩者無關。
# 上游預設都是 True（api/config.py:708-711）。本檔只關前者。
#
# **為什麼關掉**：答案快取的 key 不含知識庫的內容或版本。實際餵給
# `compute_args_hash` 的是（operate.py:4317-4333）：快取政策版本、mode、問題原文、
# response_type、top_k、chunk_top_k、max_entity/relation/total_tokens、抽出來的
# 高低階關鍵字、user_prompt、enable_rerank、enable_content_headings、模型身分。
# **沒有一項代表「庫裡有什麼」。**
# ⇒ 新論文進庫、圖譜重抽之後，同一個問題會回**重抽以前的答案**，直到有人剛好
#   改了 top_k 那類參數才失效。對一個還在進料、還要重抽的庫，這等於讓它說舊話。
# ⇒ 也因此「重抽有沒有變好」在快取開著的時候量不出來。
#
# 要改成 true 的前提：先有一條「知識庫變動就清掉查詢快取」的機制。沒有那條就不要開。
# （歷史：這個 false 是初始部署 678930e 就設的，沒有留下理由 —— 是「一開始就這樣」，
#   不是量過之後的決定。2026-08-08 補上以上依據。）
#
# ⚠ 不要關掉 ENABLE_LLM_CACHE_FOR_EXTRACT。上游註解寫明「LLM cache is required for
#   entity/relation rebuild after file deletion」，而且它正是 2026-08-08 換 embedding
#   只花 45 秒的原因（452 筆抽取快取全部命中，只有向量真的重算）。本檔刻意不設它，
#   讓它留在預設的 True。
ENABLE_LLM_CACHE=false

# ── Rerank（本機 Infinity，與 embedding 同一個容器）─────────────────────
# 2026-08-08 上線。在這之前 RERANK_BINDING 有值但沒設模型 ——「開著卻沒在做事」，
# 而且不會報錯。
#
# 為什麼 binding 是 `cohere`：那是 LightRAG 對「通用 rerank HTTP 介面」的稱呼，
# 不是真的打 Cohere。Infinity 的 /rerank 就吃這個格式。
# ⚠ HOST 必須**完整含 `/rerank`**（embedding 那邊反而只要根路徑，由 binding 自己
#   接 `/embeddings`）。兩者規則不同，見 compose.yaml 的註解。
# ⚠ RERANK_MAX_TOKENS_PER_DOC 一定要顯式設。**同一個預設值在不同路徑不一樣**：
#   `generic_rerank_api` 是 480、`cohere_rerank` 是 4096 —— 480 會把長 chunk 截掉
#   大半再去評分。看到一個預設值不能假設它適用所有路徑。
#
# 圖譜與 rerank 是**互補的**，不是二選一（2026-08-08 實測：rerank 上線後
# 「圖譜值不值得」的答案翻轉）。
RERANK_BINDING=cohere
RERANK_BINDING_HOST=http://lightrag-infinity:7997/rerank
RERANK_BINDING_API_KEY=changeme
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_TOKENS_PER_DOC=8192
# 本機 llama.cpp 沒開 --parallel 時只有 1 個 slot（實測 /slots 回 1），
# 請求會排隊。MAX_ASYNC=4 打 1 個 slot，第 4 個請求要等前 3 個跑完，
# 實際等待約 4 倍單次時間，直接撞上外層 480s（=LLM_TIMEOUT 240 的兩倍）
# —— 實測 10 次逾時、1 份文件整份失敗，而逾時的 chunk 大小都很正常。
# 兩張 GPU 幫不上忙：層分割仍是一個實例、一次一個 forward pass。
# 真正要提升吞吐得在伺服器端開 --parallel N（連續批次），開了之後
# MAX_ASYNC 才有意義往上調。
#
# ── 2026-08-03：上面那個條件已經成立，值改成 4（SPEEDUP-2）──────────
# 伺服器現在跑 --parallel 4（啟動 log n_slots = 4、n_ctx_slot = 32768），
# 所以 4 個並行請求各進一個 slot，不再排隊 —— 上面那場逾時災難的成因
# （4 個請求擠 1 個 slot）已經不存在。
#
# 實測（scripts/llm-bench.py，8 個真實抽取請求、cache_prompt=false、
# max_tokens=4096、無截斷、兩輪反序；報告在 $RECORDS/bench/）：
#
#   併發 1   67.8／68.0 tok/s   p50 25 s
#   併發 2   84.0／81.8         p50 32／40 s     ← 舊值
#   併發 4  107.5／105.4        p50 60／64 s     ← +28%，本值
#   併發 8  110.0／112.9        p50 97／110 s    ← 只再多 4.6%，延遲翻倍
#
# 不調到 8 的理由就是最後一列：GPU 在 4 已接近飽和（曲線壓平），
# 再加併發只換到延遲。c=4 最慢一題實測 95 s，對 LLM_TIMEOUT=600 有 6 倍餘裕。
LLM_TIMEOUT=600
MAX_ASYNC=4

# ── 查詢預算：這個鍵掉了，知識庫會開始對使用者說謊 ──────────────────────
# 2026-08-08 找到的缺陷：查詢組出的 prompt 約 33k，撞上 llama.cpp **每個 slot** 的
# 32,768（`-c 131072 ÷ --parallel 4`），伺服器回 400，而 LightRAG 把這個錯誤翻譯成
#   No relevant context found for the query.
# **知識庫有料，卻對使用者說查無資料，而且沒有任何紅燈。**
# 修前 12 次生成：4 次假「找不到」、7 次截斷、1 次完整。修後 12 次**全部完整、
# 零錯誤零截斷**。
#
# ⚠ 為什麼是 25000 不是 28000：slot 上限之外還要扣系統提示約 3,350 與答案本身要留
#   的空間。28000 會讓 400 消失但**截斷繼續**——錯誤不見了不等於修好了。
# ⚠ 這個值與伺服器端的 `-c` 和 `--parallel` 是**乘除關係**，而沒有任何人在守它：
#   改動 `--parallel`（每 slot 的 context 跟著變）就必須重算這裡。這是 2026-08-08
#   最貴的一課——兩個各自合理的設定，關係沒人守。
#   每 slot 上限 = -c ÷ --parallel；本值需 ≤ 該上限 − 3350 − 答案空間。
MAX_TOTAL_TOKENS=25000

# ── 圖譜可以吃掉多少預算（**原文是最後才分到的**）────────────────────────
# 分配順序（operate.py:5339）：
#   可給原文的 = MAX_TOTAL_TOKENS − (系統提示 + 圖譜context + 問題 + 緩衝 200)
# 也就是圖譜先拿，剩下的才給原文。上游預設是 6000＋8000＝14000，佔 25000 的 56%。
#
# 2026-08-08 用 `scripts/context-budget.py` 實測四題（不是估算，是問 LightRAG
# 自己的 tokenizer 數的）：
#
#   查詢                     圖譜      原文    原文筆數
#   coiled-up channel      13,608    9,090       5
#   micro-perforated Z_Mi  13,055   10,653       6
#   coupled resonators     11,132   12,369       8
#   orifice partition      13,986    9,901       9
#
# 圖譜穩定貼著 14000 上限，原文只拿到 9,000–12,400，而**筆數 5–9 遠低於
# CHUNK_TOP_K 的 20** ⇒ 擋住原文的是 token 預算不是數量上限，所以把預算還給它有效。
#
# ⚠ 判斷「該不該加預算」的方法：跑 context-budget.py 看原文筆數。
#   筆數 < CHUNK_TOP_K ⇒ token 在擋，加預算有用
#   筆數 = CHUNK_TOP_K ⇒ 數量上限在擋，加預算沒用，要改 CHUNK_TOP_K
#   （但 CHUNK_TOP_K 不能隨便調高：compat-check A-25 守著它，kbapi 的節流靠它。）
MAX_ENTITY_TOKENS=3000
MAX_RELATION_TOKENS=4000

# ── 後處理：第二雙眼睛（交叉驗證用）──────────────────────────────
# 必須跟 LLM_MODEL 不同家族，否則錯誤相關、交叉驗證失去意義。
#
# ⚠ **PP_EYE_B_API_KEY 必須單獨設，不能再靠 fallback。**
#   `pp/eyes.py:87` 寫的是 `PP_EYE_B_API_KEY or EMBEDDING_BINDING_API_KEY`，那條
#   fallback 成立的前提是「embedding 用的就是 OpenAI 金鑰」。2026-08-08 embedding
#   換成本機 BGE-M3 之後前提消失，而**沒有東西會告訴你**：
#     同一把金鑰打 api.openai.com/v1/models → HTTP 401
#     同一把金鑰打 :7997/models             → HTTP 200
#   這是「改 A 讓 B 安靜地失效」的典型，B 只在下次進料跑後處理時才會炸。
PP_EYE_B_HOST=https://api.openai.com/v1
PP_EYE_B_API_KEY=changeme
PP_EYE_B_MODEL=gpt-5.6-luna
# gpt-5 系列是推理模型：要用 max_completion_tokens，且不接受 temperature=0
#（實測回 "Only the default (1) value is supported"），所以輸出是隨機的。
PP_EYE_B_REASONING=true
PP_EYE_B_MAX_OUT=6000

# ── 部署（依機器而異）──
# 服務綁定位址。腳本一律從這裡讀，不要寫死 localhost。
# ⚠ dker 上的實際值是 Tailscale 位址（compose 的預設也是），**不是 127.0.0.1**。
#   綁成 127.0.0.1 的話容器起得來、健康檢查也綠，但 skill、kbapi 的呼叫端與
#   瀏覽器全部連不到 —— 這正是 compat-check A-27 要抓的那種壞法。
BIND_ADDR=100.87.88.7
HOST_PORT=9621
# Infinity（本機 embedding ＋ rerank）發佈到宿主的埠。容器內恆為 7997。
# compose 寫成 ${INFINITY_PORT:-7997}，所以實機的 .env 可以省略這個鍵；
# 記在這裡是因為「有預設值」不等於「不必記載」——A-27 要靠它組出健康檢查的網址。
INFINITY_PORT=7997
# kbapi（唯讀圖片／單篇結構端點）發佈到宿主的埠。容器內恆為 9700。
# 為什麼要這個鍵：compose.yaml 進版控、被多個 checkout 共用，而「哪個 workspace
# 佔 9700」是**部署事實**不是原始碼事實。曾經用 `profiles:` 在檔案裡停用某一邊，
# 結果分支合併時那行跟著進主線，:9700 靜靜消失、skill 全啞且不報錯。
# 規則：現役的那個 workspace 用 9700（skill 寫死打它），其餘候補庫錯開（9701…）。
KBAPI_PORT=9700
# INTAKE_PORT 已於 2026-08-08 從本檔移除 —— **沒有任何程式在讀它**（compose.yaml
# 不含審核台，見該檔第 150 行；intake.py:2709 的 `--port` 預設就是 9710）。
# 留著一個沒人讀的鍵，會讓下一個人以為改它就能換埠。
# 為什麼是 9710（理由保留）：避免與 LightRAG :9621、kbapi :9700 重疊，且與
# 2026-08-04 實測的手動 intake 服務埠一致，compose 接手後不必改入口網址。
# 要換埠請改 intake.py 的 `--port` 預設或啟動時帶參數。
#
# 收件匣要掃描的來源白名單，可用逗號分隔多個目錄。
# **刻意留空（2026-08-07）**：舊值是 /data/rag/knowledge_bases/Room_Optimizer/raw，
# 而 PO 已定案廢除 /data/rag，該目錄本身也已不存在。留空是安全的 ——
# intake.py:1778 會過濾掉空字串，且 :494 在沒有來源時明確警告「尚未設定
# INTAKE_SOURCES；選片清單不代表來源為空」，不會把「沒設定」講成「來源是空的」。
# 現在的進料方式是把 PDF 丟進 DATA_ROOT/inbox 或直接在 :9710 網頁上拖拉上傳。
# 要恢復掃描某個來源庫時，指向該庫的 PDF 目錄，並確認 compose 對它是唯讀掛載
# （避免 intake 寫回別人的語料）。
INTAKE_SOURCES=
# 所有 lightrag 資料的根目錄，放在 /data 的獨立 NVMe，與其他 RAG 專案完全切開。
# compose 會從這裡分出 inputs/<workspace>、work/parsed、work/crops、records、
# checks 與 rag_storage；DB 仍由 LIGHTRAG_DB_ROOT 另外控制。備份範圍與還原責任
# 以 dker 上的實際排程設定為準，不能只靠這行文字推定。
DATA_ROOT=/data/lightrag
# Postgres 資料目錄的根。與 DATA_ROOT 分開的理由：DB 是**唯一不可再生**的東西，
# 語料重抽得回來、向量重算得回來，DB 掉了就沒了，所以它的路徑要能單獨搬到別的
# 磁碟而不動其他資料。compose.yaml:196 用 `${LIGHTRAG_DB_ROOT:-/data/lightrag}/postgres`
# 掛載，backup-cold.sh:39 也從這個鍵讀備份來源 —— **這個鍵掉了，冷備份會備錯地方**。
LIGHTRAG_DB_ROOT=/data/lightrag
# 可選的 inputs 宿主目錄。留空時由 compose 使用 DATA_ROOT/inputs，並讓 LightRAG
# 在其下建立 ${WORKSPACE} 子目錄；不要直接指向別的語料庫來源目錄。
INPUTS_DIR=

# ── 第三隻眼睛：為什麼需要它（Mathpix 是沒走成的那條路）──────────────
# 為什麼要第三個：兩眼一致時判定可靠，但實測 30 條裡 11 條（37%）兩眼不一致，
# 那時候誰對誰錯沒有依據 —— qwen 會誤讀羅馬數字、luna 會看錯字元，兩個都可能錯。
# 原本的候選是 Mathpix（專為數學訓練，失誤型態與通用 VLM 不相關）。
# **MATHPIX_APP_ID／MATHPIX_APP_KEY 已於 2026-08-08 從本檔移除**：全 repo 沒有
# 任何程式讀它們（`grep -rn MATHPIX --include='*.py'` 零命中），實際擔任第三隻眼
# 的是下面的 PP_EYE_C（OpenRouter），成本也低得多——同樣範圍 Mathpix 約 $6.5、
# PP_EYE_C 約 $0.7。要改用 Mathpix 得先寫 adapter，屆時再把鍵加回來。
#
# ── 第三隻眼睛（OpenRouter）：只在三方皆異時才呼叫 ──
# 為什麼走 OpenRouter：一把金鑰通吃多個家族，換模型是改設定不是寫 adapter。
# 這跟「綁模型的觀察會過期」那條規則直接相關（compat-check A-23）——
# 換代成本趨近於零，才有可能真的定期換。
#
# 家族必須跟 LLM_MODEL（qwen）和 PP_EYE_B_MODEL（openai）都不同，
# eyes.assert_distinct() 會擋下重複 —— 同家族的系統性誤讀會一起發生，
# 多數決就變成一個血統投兩票。
#
# PP_EYE_C_PROVIDER 一定要填：OpenRouter 會把同一個模型 ID 路由到不同供應商，
# 輸出行為因此會變。交叉驗證的前提是「模型固定」，不釘住就分不清差異是
# 模型讀錯還是換了後端。供應商名稱在 openrouter.ai 的模型頁面查得到。
#
# 成本：只處理 13% 的三方皆異，390 份估算約 $0.7（Mathpix 同樣範圍要 $6.5）。
PP_EYE_C_HOST=https://openrouter.ai/api/v1
PP_EYE_C_MODEL=google/gemini-2.5-flash-lite
PP_EYE_C_API_KEY=
PP_EYE_C_PROVIDER=
# 很多模型（含 MiMo、gpt-5 系列、DeepSeek v4）是推理模型：推理會先吃掉額度，
# 不夠時 content 回空字串、finish_reason=length —— 看起來像模型壞掉，實際是
# 被截斷。本專案在三個不同模型上踩過同一個坑，所以額度一律給寬。
# 實測 MiMo 給 3072 時 4 條裡 2 條空回應，改 8000 全部正常。
PP_EYE_C_REASONING=false
PP_EYE_C_MAX_OUT=8000

# ---- 警報 ----
